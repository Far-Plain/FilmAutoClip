{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "film-frame-stats",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8080,https://far-plain.github.io/FilmAutoClip/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "film-frame-stats",
      "database_id": "f73cf162-e619-4318-ac29-4922fbff401e"
    }
  ]
}
